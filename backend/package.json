{
  "name": "oceanroute-backend",
  "version": "2.0.0",
  "description": "OceanRoute / Nautilus — Core Backend Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test tests/*.test.js",
    "test:auth": "node --test tests/auth.test.js",
    "test:ships": "node --test tests/ships.test.js",
    "test:ports": "node --test tests/ports.test.js",
    "test:voyages": "node --test tests/voyages.test.js",
    "test:health": "node --test tests/health.test.js",
    "test:route": "node --test tests/route.test.js",
    "test:unit": "node --test tests/route.test.js --grep \"Unit\"",
    "test:marine": "node --test tests/marine.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "is-sea": "^0.3.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.14.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
