# OceanRoute / Nautilus — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────
PORT=5005

# ── MySQL Database ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=oceanroute

# ── JWT ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_at_least_64_random_characters
JWT_EXPIRES_IN=24h

# ── CORS ──────────────────────────────────────────────────────────────
# Frontend origin — no trailing slash
CLIENT_URL=http://localhost:5173

# ── Environment ───────────────────────────────────────────────────────
NODE_ENV=development

# =======================================================================
# BE3 — Marine Intelligence Configuration
# =======================================================================

# ── Demo Mode ─────────────────────────────────────────────────────────
# Set to "true" to activate deterministic ship simulation.
# In demo mode, ship positions are computed from the voyage start time
# and ship speed — no live AIS feed is required.
# The simulated ship (SHIP001) moves along the Mumbai → Colombo route.
# Set to "false" (or omit) in production to use only real DB positions.
DEMO_MODE=true

# ── Weather Cache TTLs (minutes) ──────────────────────────────────────
# How long a weather observation stays valid before re-fetching from
# the Open-Meteo API. Reduce these in production for fresher data;
# increase them if you hit Open-Meteo rate limits.
WEATHER_TTL_MINUTES=30
OCEAN_TTL_MINUTES=15
MARINE_WEATHER_TTL_MINUTES=30

# ── Open-Meteo Resilience ─────────────────────────────────────────────
# Timeout per request to Open-Meteo (milliseconds).
OPEN_METEO_TIMEOUT_MS=15000

# Maximum number of retry attempts on a transient failure before
# falling back to cached data or returning "unavailable".
OPEN_METEO_MAX_RETRIES=3
